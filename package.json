{
    "name": "gestordoc",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "analyze": "ANALYZE=true pnpm run build",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate:pg",
        "db:migrate": "tsx db/migrate.ts",
        "test": "vitest",
        "test:integration": "vitest run --config ./vitest.config.ts --include '**/*.integration.test.ts'",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.588.0",
        "@aws-sdk/s3-request-presigner": "^3.588.0",
        "@paralleldrive/cuid2": "^2.2.2",
        "bcryptjs": "^2.4.3",
        "drizzle-orm": "^0.31.2",
        "next": "^14.2.3",
        "postgres": "^3.4.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.8.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.44.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.12.12",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "dotenv": "^16.4.5",
        "drizzle-kit": "^0.21.4",
        "pg": "^8.11.5",
        "tsx": "^4.11.0",
        "typescript": "^5.4.5",
        "vite-tsconfig-paths": "^4.3.2",
        "vitest": "^1.6.0"
    }
}